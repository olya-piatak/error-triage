# Copy to .env and fill in. Never commit .env.

# Where errors come from: posthog | sentry | json
SOURCE=json

# --- SOURCE=json ---
JSON_PATH=fixtures/errors.sample.json

# --- SOURCE=posthog ---
# POSTHOG_HOST=https://us.posthog.com
# POSTHOG_PROJECT_ID=12345
# POSTHOG_API_KEY=phx_personal_api_key

# --- SOURCE=sentry ---
# SENTRY_BASE_URL=https://sentry.io
# SENTRY_ORG=my-org
# SENTRY_PROJECT=my-project
# SENTRY_AUTH_TOKEN=sntrys_token

# --- LLM (any OpenAI-compatible /chat/completions endpoint) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Set to "stub" to skip the network and use the built-in heuristic model.
# LLM_PROVIDER=stub

# --- Slack incoming webhook (optional with --dry-run) ---
SLACK_WEBHOOK_URL=

# --- Report ---
REPORT_TIMEZONE=UTC
MAX_GROUPS=15
STATE_PATH=.triage-state.json
